# Copy to /srv/test/shared/.env on the server (chmod 600) and fill in the values.
# Never commit the real .env — see Knowledge/standards/security-secrets.md.

APP_ENV=production
APP_DEBUG=false

# Display timezone of the rendered page. All astronomical maths runs in UTC.
APP_TIMEZONE=Europe/Budapest

# The endpoint the page polls for the sky. Relative to the document root by default,
# so a deployment normally does not need to set it at all.
SKY_API_URL=api/sky.php
